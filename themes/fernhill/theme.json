{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f4f7f3" },
				{ "slug": "ink", "name": "Ink", "color": "#1c2b22" },
				{ "slug": "muted", "name": "Muted", "color": "#5a6a60" },
				{ "slug": "line", "name": "Line", "color": "#dfe7e1" },
				{ "slug": "brand", "name": "Brand", "color": "#2f6b4f" },
				{ "slug": "brand-dark", "name": "Brand dark", "color": "#204d38" },
				{ "slug": "brand-soft", "name": "Brand soft", "color": "#e6f0e9" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.15rem" },
				{ "slug": "large", "name": "Large", "size": "1.6rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(2rem, 4vw, 2.75rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "1.0625rem",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "24px",
				"right": "24px"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--brand)" },
				":hover": { "color": { "text": "var(--wp--preset--color--brand-dark)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.25" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brand)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "600" },
				"spacing": {
					"padding": { "top": "12px", "bottom": "12px", "left": "24px", "right": "24px" }
				},
				":hover": { "color": { "background": "var(--wp--preset--color--brand-dark)" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "1.25rem", "fontWeight": "800" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--ink)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "0.95rem", "fontWeight": "500" },
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
