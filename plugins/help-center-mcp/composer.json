{
	"name": "help-center/help-center-mcp",
	"description": "A help center that AI assistants can search, read and draft through the Model Context Protocol.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"anthropic-ai/sdk": "^1.3",
		"guzzlehttp/guzzle": "^7.9"
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"php-http/discovery": false
		}
	}
}
